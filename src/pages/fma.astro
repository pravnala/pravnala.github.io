---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerHero from '../components/layout/InnerHero.astro';
import AboutTheArt from '../components/fma/AboutTheArt.astro';
import InstructorProfile from '../components/fma/InstructorProfile.astro';
import TrainingPhilosophy from '../components/fma/TrainingPhilosophy.astro';
import Curriculum from '../components/fma/Curriculum.astro';
import LapuntiKarilyon from '../components/fma/LapuntiKarilyon.astro';
import ArnisTestimonials from '../components/fma/fmaTestimonials.astro';
import MediaGallery from '../components/fma/MediaGallery.astro';
import ArnisCTA from '../components/fma/fmaCTA.astro';
import heroData from '../data/fma/hero.json';

const fmaPracticeYears = new Date().getFullYear() - 2010;
const fmaTeachingYears = new Date().getFullYear() - 2015;
const heroDescription = heroData.description
  .replace('{fmaPracticeYears}', String(fmaPracticeYears))
  .replace('{fmaTeachingYears}', String(fmaTeachingYears));
---

<BaseLayout
  title="Lapunti Arnis De Abanico"
  description={`${fmaPracticeYears} years of practice and ${fmaTeachingYears} years of teaching Lapunti Arnis De Abanico — a Filipino martial art from Cebu, Philippines. Train with Guro Alvin Penaflor.`}
>
  <InnerHero title={heroData.title} description={heroDescription} />
  <AboutTheArt />
  <InstructorProfile />
  <TrainingPhilosophy />
  <Curriculum />
  <LapuntiKarilyon />
  <!-- <ArnisTestimonials /> -->
  <MediaGallery />
  <ArnisCTA />
</BaseLayout>
